    "@radix-icons/vue": "^1.0.0",
    "@tabler/icons-vue": "^3.24.0",
    "@vee-validate/zod": "^4.14.7",
    "@vueuse/core": "^12.0.0",
    "agnostic-vue": "^1.1.3",
    "axios": "^1.7.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-vue-next": "^0.468.0",
    "mitt": "^3.0.1",
